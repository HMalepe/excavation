# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ANTHROPIC_API_KEY=replace-with-anthropic-key

# Models: fast tier for the per-message safety screen (A); strong tier for B–H (spec 07 §1)
AI_EFFORT_CONVERSATION=medium
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_STRONG=claude-opus-5-5

# Report release policy (spec 07 §1): first N reports go to human review
REVIEW_FIRST_N_REPORTS=200

# Safeguarding alerts (spec 09 §5): flags show on /staff/safeguarding and /school/safeguarding;
# urgent ones are also emailed. Leave blank in dev: emails are logged instead of sent.
RESEND_API_KEY=
SAFEGUARDING_FROM_EMAIL=safeguarding@theexcavation.co.za
EXCAVATION_SAFEGUARDING_LEAD_EMAIL=
# Shared secret used by the scheduler that calls /api/cron/* routes
CRON_SECRET=replace-with-long-random-string

# Cost kill switch: most Guide replies, all learners together, per UTC day (default 20000)
AI_DAILY_GUIDE_LIMIT=20000

# Retention sweep (daily cron). It only REPORTS what it would delete until this is "true".
RETENTION_ENABLED=false
# Set to "true" once the attorney has signed off the guardian consent form (removes the DRAFT banner on printed forms).
CONSENT_FORM_APPROVED=false

# Staff two-step sign in (authenticator app). Defaults to REQUIRED in production, off in development.
# "off" is a break-glass for an incident only: it removes the second step for every staff account.
STAFF_MFA=
