  "nsc_pass_types": {
    "_warning": "Simplified from the NSC promotion requirements. VERIFY against current DBE regulations before launch and every year.",
    "bachelor": {
      "label": "Bachelor's pass (degree study)",
      "rule": "Home Language >= 40%; four other subjects from the designated list >= 50% (excluding LO); remaining subjects >= 30%; language of learning and teaching >= 30%."
    },
    "diploma": {
      "label": "Diploma pass",
      "rule": "Home Language >= 40%; four other subjects >= 40% (excluding LO); remaining >= 30%."
    },
    "higher_certificate": {
      "label": "Higher Certificate pass",
      "rule": "Home Language >= 40%; two other subjects >= 40%; three others >= 30%."
    },
    "nsc": {
      "label": "NSC pass",
      "rule": "Home Language >= 40%; two other subjects >= 40%; three others >= 30%; failing at most one subject (with conditions)."
    }
  },
  "aps": {
    "_warning": "Generic 7-point NSC scale. Each university calculates APS differently (some include LO, some weight Maths/English, Wits/UCT/Stellenbosch use their own scores). Store per-institution rules in a separate table and verify yearly.",
